# Copy to apps/api/.env for local development. Never commit the real .env.
# All variables are validated at startup by src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Postgres from compose.yaml (pnpm db:up). On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruut_stocks

# At least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Free key from https://twelvedata.com (Basic plan: 8 credits/min, 800/day)
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_CREDITS_PER_MINUTE=8
TWELVE_DATA_CREDITS_PER_DAY=800
# Minutes of delay shown in the UI badge (Basic plan: US equities are real time)
TWELVE_DATA_DELAY_MINUTES=0

# Seed only (the server starts without them). Must match DEMO_USER_* in apps/web.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
