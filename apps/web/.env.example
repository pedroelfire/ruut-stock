# Copy to apps/web/.env.local for local development. Never commit the real file.
# Server-only variables: none of them is exposed to the browser.
# Next.js expands `$VAR` inside .env files: write a literal `$` as `\$` (for example in
# DEMO_USER_PASSWORD), or the value silently changes. apps/api (node --env-file) does not expand.

# Express API base URL. On Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL=http://localhost:4000

SESSION_COOKIE_NAME=ruut_session

# Demo account used by the "Use demo account" button
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
